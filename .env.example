# ═══════════════════════════════════════════════════════════════
# Required: SmoothSend API Key
# ═══════════════════════════════════════════════════════════════
# Get one at https://dashboard.smoothsend.xyz
# sk_ (secret key) — this only ever runs server-side (API routes / cron)
SMOOTHSEND_API_KEY=sk_nogas_your_key_here

# ═══════════════════════════════════════════════════════════════
# Required: the fly's EOA private key
# ═══════════════════════════════════════════════════════════════
# Same wallet every deploy — without this every restart is a new $0 fly.
PRIVATE_KEY=0x_your_eoa_private_key_here

# ═══════════════════════════════════════════════════════════════
# Network
# ═══════════════════════════════════════════════════════════════
# avalanche-fuji | avalanche-mainnet
WALLET_NETWORK=avalanche-mainnet

# ═══════════════════════════════════════════════════════════════
# Budget limits (in USDC) — keep tight, this is real money
# ═══════════════════════════════════════════════════════════════
WALLET_DAILY_LIMIT=5
WALLET_PER_TX_LIMIT=2

# ═══════════════════════════════════════════════════════════════
# Dev safety: run the full tick loop (quote, RL decide, reward) but
# skip submitSponsoredCalls — no real funds move.
# ═══════════════════════════════════════════════════════════════
SIMULATE_ONLY=true

# ═══════════════════════════════════════════════════════════════
# Supabase — Q-table + tick history persistence
# ═══════════════════════════════════════════════════════════════
# Project Settings -> API. Use the service_role key (server-only, never
# exposed to the client) — everything here runs from our own API routes.
# Run supabase-schema.sql once in the SQL editor before first use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ═══════════════════════════════════════════════════════════════
# Secures /api/tick — Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once set as a project env var.
# Use the same value + header for a manual force-tick call (demo video).
# Generate one with: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════
CRON_SECRET=
